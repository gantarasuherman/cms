# Lokasi project relatif terhadap folder laradock/ ini.
APPLICATION=../

PHP_VERSION=8.3
NODE_VERSION=20

# Port host. Semuanya sengaja dijauhkan dari port bawaan (80, 3306, 6379)
# dan dari project lain di mesin ini; ubah bebas bila bentrok.
#
# Semuanya juga dijaga tetap DI BAWAH 50000. Windows memesan blok-blok port
# tinggi untuk dirinya sendiri (Hyper-V, WinNAT), dan blok itu bergeser setiap
# kali mesin dinyalakan ulang. Port di wilayah itu bekerja berhari-hari lalu
# tiba-tiba ditolak:
#
#   bind: An attempt was made to access a socket in a way forbidden by its
#   access permissions
#
# Daftar blok yang sedang dipesan:
#   netsh interface ipv4 show excludedportrange protocol=tcp
NGINX_HOST_HTTP_PORT=8010
MYSQL_HOST_PORT=33066
REDIS_HOST_PORT=6380
PHPMYADMIN_HOST_PORT=8082
VITE_HOST_PORT=5173

MYSQL_DATABASE=cms
MYSQL_USER=cms
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root

# Mode layanan bot.
#   auto  — menguras outbox saja bila belum ada kredensial, naik sendiri ke
#           long polling Telegram begitu tokennya terisi. Tidak pernah mati
#           berulang pada pemasangan yang belum dikonfigurasi.
#   poll  — paksa long polling Telegram.
#   drain — outbox saja.
#   serve — webhook FastAPI. Wajib untuk WhatsApp (Meta tidak punya polling)
#           dan perlu HTTPS publik; dari localhost butuh tunnel.
BOT_MODE=auto
BOT_HOST_PORT=8011

# Tunnel HTTPS publik untuk webhook WhatsApp. Meta tidak menyediakan polling,
# jadi tanpa ini WhatsApp tidak dapat dites dari mesin sendiri.
# Authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
# Domain statis: https://dashboard.ngrok.com/domains (gratis, satu per akun)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
NGROK_INSPECT_PORT=4041
