APP_NAME="Dynamic CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cms
DB_USERNAME=cms
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Di dalam Docker pakai nama service (mysql, redis). Menjalankan artisan dari
# host? Ganti DB_HOST=127.0.0.1 DB_PORT=33066 dan REDIS_HOST=127.0.0.1
# REDIS_PORT=63790.

# CAPTCHA halaman login. "null" menonaktifkan tantangan (pengembangan, CI);
# "turnstile" mengaktifkannya begitu kedua kunci di bawah terisi.
CAPTCHA_DRIVER=null
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Akun administrator pertama yang dibuat AdminUserSeeder.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=password

# Rahasia bersama Laravel dan layanan bot Python. Layanan bot membaca berkas
# .env ini juga, jadi kedua sisi tidak mungkin memakai nilai berbeda.
# Buat nilainya: php -r 'echo bin2hex(random_bytes(32));'
BOT_INTERNAL_TOKEN=

# Kredensial saluran chatbot. Boleh dibiarkan kosong — panel admin
# menyimpannya terenkripsi dan nilai dari panel menang atas yang di sini.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Asisten bahasa untuk chatbot. Mati secara bawaan dan tidak pernah menanggung
# beban: setiap tempat yang memakainya punya perilaku cadangan.
AI_ENABLED=false

# ID publik Meta, bukan rahasia. Access token dan app secret tetap kosong
# sampai diisi — tanpa app secret seluruh webhook WhatsApp ditolak.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Nomor aplikasi Meta (Meta → App → Settings → Basic), juga bukan rahasia.
#
# Diisi bersama WHATSAPP_APP_SECRET, layanan bot mendaftarkan sendiri alamat
# webhooknya ke Meta setiap kali naik. Itu yang membuat alamat tunnel yang
# berubah-ubah tidak perlu ditempel ulang ke dasbor Meta setiap
# `docker compose up`. Dikosongkan, alamatnya tetap dicetak di log bot untuk
# disalin sekali dengan tangan.
WHATSAPP_APP_ID=

# Alamat HTTPS publik layanan bot, bila memang sudah tetap: domain sendiri,
# named tunnel Cloudflare, atau domain statis ngrok. Contoh:
#   BOT_PUBLIC_URL=https://bot.pupr.indramayukab.go.id
#
# Dikosongkan, alamatnya ditanyakan ke cloudflared setiap kali layanan naik.
# Quick tunnel Cloudflare tidak dapat dipesan namanya: ia acak dan berubah
# setiap container dibuat ulang, jadi sebuah alamat trycloudflare.com tidak
# pernah pantas ditulis di sini.
BOT_PUBLIC_URL=
